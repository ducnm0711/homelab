## PERCONA POSTGRESQL STACK
  - name: pg-operator
    namespace: dbs
    chart: percona/pg-operator
    version: 2.8.0
    labels:
      lab: postgresql
      postgresql: "true"
    inherit:
      - template: default

  - name: pg-cluster
    namespace: dbs
    chart: charts/pg-db
    version: 2.8.0
    labels:
      lab: postgresql
      postgresql: "true"
    inherit:
      - template: default

  - name: pmm
    namespace: obs
    chart: percona/pmm
    version: 1.4.13
    labels:
      lab: postgresql
      postgresql: "true"
    inherit:
      - template: default

## LGTM STACK - OTEL COLLECTOR, LOKI, GRAFANA
  - name: grafana-operator
    namespace: obs
    chart: grafana-oci/grafana-operator
    version: 5.23.0
    labels:
      lab: lgtm
      lgtm: "true"
    inherit:
      - template: default

  - name: grafana
    namespace: obs
    chart: charts/grafana-resources
    version: 1.0.0
    labels:
      lab: lgtm
      lgtm: "true"
    inherit:
      - template: default

  - name: loki
    namespace: obs
    chart: grafana-community/loki
    version: 17.1.7
    labels:
      lab: lgtm
      lgtm: "true"
    inherit:
      - template: default

  - name: tempo
    namespace: obs
    chart: grafana-community/tempo
    version: 2.2.0
    labels:
      lab: lgtm
      lgtm: "true"
    inherit:
      - template: default

  - name: alloy
    namespace: obs
    chart: grafana/alloy
    version: 1.8.2
    labels:
      lab: lgtm
      lgtm: "true"
    inherit:
      - template: default

