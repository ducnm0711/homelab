## CASSANDRA STACK
  - name: cert-manager
    namespace: infra
    chart: cert-manager/cert-manager
    version: v1.20.2
    labels:
      service: infra
      lab: shared
      lgtm: "true"
      cassandra: "true"
      postgresql: "true"
      openbao: "true"
    inherit:
    - template: default

  - name: k8ssandra-operator
    namespace: dbs
    chart: k8ssandra/k8ssandra-operator
    version: 1.32.1
    labels:
      service: cassandra
      lab: cassandra
      cassandra: "true"
    inherit:
      - template: default

  - name: openbao
    namespace: infra
    chart: openbao/openbao
    version: 0.26.2
    labels:
      lab: openbao
      openbao: "true"
    inherit:
    - template: default

  - name: tailscale
    namespace: infra
    chart: tailscale/tailscale-operator
    version: 1.98.4
    labels:
      lab: openbao
      openbao: "true"
    inherit:
    - template: default

## OBJECT STORAGE
  - name: rustfs
    namespace: infra
    chart: rustfs/rustfs
    version: 0.7.0
    labels:
      lab: lgtm
      lgtm: "true"
    inherit:
